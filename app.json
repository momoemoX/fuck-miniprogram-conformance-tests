{
  "pages": [
    "pages/suite/index",
    "pages/receiver/index",
    "pages/surface/index",
    "pages/input/index",
    "pages/profile/index",
    "pages/tab/index",
    "pages/transit/index",
    "pages/lifecycle/index",
    "pages/comp-page/index",
    "pages/meta-page/index",
    "pages/gallery/index",
    "pages/route-done/index",
    "pages/lazy-host/index"
  ],
  "window": {
    "navigationBarTitleText": "Conformance tests"
  },
  "style": "v2",
  "workers": "workers",
  "subPackages": [
    {
      "root": "pack",
      "pages": [
        "stop/index"
      ]
    },
    {
      "root": "indie",
      "pages": [
        "page/index"
      ],
      "independent": true
    }
  ],
  "permission": {
    "scope.userLocation": {
      "desc": "The optional device test checks whether location coordinates are in range."
    }
  },
  "requiredPrivateInfos": [
    "getLocation"
  ],
  "tabBar": {
    "list": [
      {
        "pagePath": "pages/suite/index",
        "text": "Suite"
      },
      {
        "pagePath": "pages/tab/index",
        "text": "Tab fixture"
      }
    ],
    "custom": true
  },
  "usingComponents": {
    "global-probe": "/components/global-probe/index"
  },
  "resolveAlias": {
    "@fixtures/*": "/fixtures/*"
  },
  "lazyCodeLoading": "requiredComponents"
}
