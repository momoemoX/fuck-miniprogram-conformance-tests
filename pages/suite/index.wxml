<import src="../../fixtures/row.wxml"/>
<wxs module="format" src="../../fixtures/format.wxs"/>
<view>
  <view id="scroll-spacer" style="height:2000px" aria-hidden="true"/>
  <button id="run" bindtap="run" disabled="{{started}}">Run suite</button>
  <navigator url="/pages/input/index">Run input and gesture cases</navigator>
  <navigator url="/pages/surface/index">Inspect API availability</navigator>
  <navigator url="/pages/profile/index?kind=device">Physical device cases</navigator>
  <navigator url="/pages/profile/index?kind=service">Hosted service cases</navigator>
  <view>Target base library: {{target}}</view>
  <view>Profiles: {{profiles}}</view>
  <view id="summary">{{summary}}</view>
  <view>{{baselineScore}}</view>
  <view wx:if="{{breakdownSummary}}">{{breakdownSummary}}</view>
  <button wx:if="{{results.length}}" bindtap="showReport">Show JSON report</button>
  <text wx:if="{{reportText}}" id="report" selectable="{{true}}">{{reportText}}</text>
  <view wx:for="{{results}}" wx:key="id">
    <view>{{item.status}} {{item.id}} [{{item.category}}]</view>
    <view>{{item.evidence}}</view>
    <view>Expected: {{item.expected}}</view>
    <view>Actual: {{item.actual}}</view>
  </view>
  <view aria-hidden="true" style="position:absolute;left:-200vw;top:0;width:100vw">
    <wxs-responder wx:if="{{wxsResponderMounted}}" id="wxs-responder" step="{{wxsResponderStep}}"/>
    <block wx:if="{{modelMounted}}">
      <model-probe id="model-probe" model:value="{{modelText}}" model:count="{{modelCount}}"/>
      <view id="model-parent-mirror" data-value="{{modelText}}" data-count="{{modelCount}}"/>
    </block>
    <block wx:if="{{eventAdvMounted}}">
      <view id="adv-outer-bind" mark:outer="page" mark:shared="outer" bind:ping="advBindOuter">
        <view id="adv-outer-mut" mut-bind:ping="advMutOuter">
          <view id="adv-mid" mark:mid="mid" mark:shared="mid" mut-bind:ping="advMutMid">
            <event-adv-host id="adv-host" mark:host="host" mark:shared="host" bind:ping="advBindHost"/>
          </view>
        </view>
      </view>
    </block>
    <block wx:if="{{virtualHostMounted}}">
      <view style="display:flex;width:120px"><normal-host-probe id="normal-host"/></view>
      <view style="display:flex;width:120px"><virtual-host-probe id="virtual-host"/></view>
    </block>
    <global-class-probe wx:if="{{globalClassMounted}}" id="global-class-probe"/>
    <block wx:if="{{styleSharedMounted}}">
      <style-shared-probe id="style-shared-probe"/>
      <view id="shared-leak-target" class="fallback-page suite-shared-leak"/>
    </block>
    <block wx:if="{{stylePageApplyMounted}}">
      <style-pas-probe id="style-pas-probe"/>
      <view id="pas-leak-target" class="fallback-page suite-pas-leak"/>
    </block>
    <tree-root wx:if="{{treeRelMounted}}" id="tree-root">
      <view>
        <tree-leaf wx:for="{{treeOrder}}" wx:key="*this" class="tree-leaf" label="{{item}}"/>
      </view>
    </tree-root>
    <async-widget wx:if="{{asyncWidgetMounted}}" id="async-widget"/>
    <component-gallery wx:if="{{galleryMounted}}" id="gallery" font="{{galleryFont}}"/>
    <reuse-list wx:if="{{reuseMounted}}" id="reuse-list"/>
    <block wx:if="{{errorMounted}}">
      <view id="error-bubble-outer" bind:boom="boomOuter">
        <view id="error-bubble-inner" bind:boom="boomInner">
          <error-probe id="error-probe" bind:boom="boomLeaf"/>
        </view>
      </view>
    </block>
    <wxs-probe wx:if="{{wxsMounted}}" id="wxs-probe-a" mode="{{wxsProbeMode}}"/>
    <wxs-probe wx:if="{{wxsMounted}}" id="wxs-probe-b" mode="read"/>
    <page-probe wx:if="{{plpMounted}}" id="page-probe" data-origin="page-probe-origin"/>
    <test-panel wx:if="{{multiSlotMounted}}" id="multi-slot">
      <view wx:for="{{multiSlotItems}}" wx:key="*this" slot="lead" class="multi-slot-item" data-value="{{item}}"/>
    </test-panel>

    <block wx:if="{{definitionMounted}}">
      <definition-probe id="definition"
        quantity="{{definitionInputs.quantity}}" text="{{definitionInputs.text}}" flag="{{definitionInputs.flag}}"
        object="{{definitionInputs.object}}" array="{{definitionInputs.array}}" flexible="{{definitionInputs.flexible}}" free="{{definitionInputs.free}}"/>
      <export-probe id="export-object" class="public-export" kind="object"/>
      <export-probe id="export-null" class="public-export" kind="null"/>
      <export-probe id="export-undefined" kind="undefined"/>
    </block>
    <template-probe wx:if="{{templateMounted}}" id="template-probe"/>
    <block wx:if="{{boundaryMounted}}">
      <view id="outer-boundary" data-kind="outer-kind" bind:probe="boundaryAncestor">
        <event-boundary id="shell" data-kind="shell-kind" nested="{{true}}" bind:probe="boundaryHost"/>
      </view>
      <pure-probe id="pure"/>
    </block>
    <block wx:if="{{contractMounted}}">
      <contract-probe id="contract-a"/>
      <contract-probe id="contract-b"/>
      <contract-probe id="contract-bound" count="{{contractCount}}"/>
    </block>
    <orchard id="family">
      <fruit-node name="pear"/><fruit-node wx:if="{{appleVisible}}" id="apple" name="apple"/>
    </orchard>
    <format-field id="decimal-field" amount="{{amount}}"/>
    <format-field id="hex-field" amount="{{amount}}" generic:formatter="hex-format"/>
    <isolated-style id="isolated" external-class="{{extClass}}"/>
    <sharing-style id="sharing"/>
    <include src="../../fixtures/controls.wxml"/>
  <test-probe id="first" />
  <test-probe id="second" />

  <view bind:notice="outer">
    <view bind:notice="middle">
      <test-probe id="bubbling" bind:payload="savePayload" bind:notice="source" />
    </view>
    <view catch:notice="middle">
      <test-probe id="stopped" bind:notice="source" />
    </view>
  </view>

  <test-panel><view slot="{{outlet}}" id="projection" style="width:100%;height:1px"/></test-panel>
  <switch id="active-switch" checked="{{true}}"/>
  <view id="hideable" hidden="{{invisible}}" style="height:12px"/>
  <view bind:notice="outer" capture-bind:notice="outerCapture">
    <view bind:notice="middle" capture-bind:notice="middleCapture">
      <test-probe id="capture" bind:notice="source"/>
    </view>
  </view>
  <state-probe wx:if="{{mounted}}" id="state" class="state-instance" />
  <state-probe id="bound" class="state-instance" flavor="{{seasoning}}"><view id="projected" data-value="projected"/></state-probe>
  <view id="measure" style="width:64px;height:16px" data-amount="{{2}}" data-enabled="{{true}}" data-code="02"/>
  <view class="fruit" wx:for="{{fruit}}" wx:key="*this" data-value="{{index + ':' + item}}"/>
  <view wx:if="{{hot}}" id="temperature" data-value="hot"/>
  <view wx:else id="temperature" data-value="cold"/>
  <template is="tag" data="{{caption: 'citrus'}}"/>
  <include src="../../fixtures/stamp.wxml"/>
  <view id="formatted" data-value="{{format.label('zest')}}"/>
  <wxs module="utils">module.exports.upper = function(s) { return s.toUpperCase(); }</wxs>
  <template name="alpha"><view id="dynamic" data-value="first"/></template>
  <template name="beta"><view id="dynamic" data-value="second"/></template>
  <template is="{{templateName}}"/>
  <view wx:for="{{pairs}}" wx:key="*this" class="pair" data-value="{{index + '/' + item}}"/>
  <block wx:for="{{groups}}" wx:for-item="group" wx:key="label">
    <view wx:for="{{group.items}}" wx:key="*this" class="cell" data-value="{{group.label + item}}"/>
  </block>
  <view id="expression" data-number="{{2 + 2}}" data-test="{{7 > 4}}" data-joined="{{'A' + '/' + 'B'}}"/>
  <view id="inline" data-value="{{utils.upper('alpha')}}"/>
  <view id="styled" class="swatch {{wide ? 'wide' : ''}}"/>
  <canvas canvas-id="swatch" style="width:8px;height:8px"/>
  <wxs module="pageCounter" src="../../fixtures/counter.wxs"/>
  <view id="page-counter" data-value="{{pageCounter.setValue(wxsPageStep)}}"/>
  <input id="focus-input-a" focus="{{focusA}}" value="{{focusValue}}" bindfocus="onFocusA" bindblur="onBlurA"/>
  <input id="focus-input-b" focus="{{focusB}}" bindfocus="onFocusB" bindblur="onBlurB"/>
  <input id="bound-input" value="{{boundInput}}"/>
  </view>
  <scroll-view id="scroll-fixture" scroll-y scroll-top="{{scrollTopValue}}" scroll-into-view="{{scrollIntoTarget}}" bindscroll="onScrollFixture" style="height:50px;width:120px">
    <view style="height:200px;width:60px" id="scroll-inner"/>
    <view id="scroll-target" style="height:20px"/>
  </scroll-view>
  <view id="watched" style="position:absolute;top:{{watchedTop}};left:0;width:60px;height:20px"/>
  <view id="animated" animation="{{animData}}" style="width:10px;height:10px"/>
</view>
