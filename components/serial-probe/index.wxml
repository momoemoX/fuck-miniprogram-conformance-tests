<wxs module="inspect" src="./inspect.wxs"/>
<view
  id="serial-view"
  data-top-field="{{inspect.describe(topField)}}"
  data-nested-keep="{{inspect.describe(nested.keep)}}"
  data-nested-has-drop="{{inspect.hasKey(nested, 'drop')}}"
  data-list-len="{{inspect.arrLen(list)}}"
  data-list-a="{{inspect.arrAt(list, 0)}}"
  data-list-b="{{inspect.arrAt(list, 1)}}"
  data-list-c="{{inspect.arrAt(list, 2)}}"
  data-nan="{{inspect.describe(nanVal)}}"
  data-pos-inf="{{inspect.describe(posInf)}}"
  data-neg-inf="{{inspect.describe(negInf)}}"
  data-ok-num="{{inspect.describe(okNum)}}"
  data-date="{{inspect.describe(dateVal)}}"
  data-buf="{{inspect.describe(bufVal)}}"
  data-marker="{{inspect.describe(marker)}}"
  data-sparse-len="{{inspect.arrLen(sparse)}}"
  data-sparse-a="{{inspect.arrAt(sparse, 0)}}"
  data-sparse-b="{{inspect.arrAt(sparse, 1)}}"
  data-sparse-inner-len="{{sparse[2] ? inspect.arrLen(sparse[2].list) : -1}}"
  data-sparse-inner-a="{{sparse[2] ? inspect.arrAt(sparse[2].list, 0) : 'missing'}}"
  data-sparse-inner-b="{{sparse[2] ? inspect.arrAt(sparse[2].list, 1) : 'missing'}}"
  data-sparse-inner-c="{{sparse[2] ? inspect.arrAt(sparse[2].list, 2) : 'missing'}}"
  data-sparse-inner-d="{{sparse[2] ? inspect.arrAt(sparse[2].list, 3) : 'missing'}}"
  data-large-len="{{inspect.strLen(largeText)}}"
  data-large-tag="{{inspect.describe(largeTag)}}"
/>
